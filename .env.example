# BACKEND ENVIRONMENT VARIABLES

# Supabase (get from Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret (generate a random string, e.g.: openssl rand -hex 32)
JWT_SECRET=your-random-secret-key-at-least-32-chars

# Database URL (Supabase → Settings → Database → Connection string)
# Use direct connection, NOT pooler, for migrations
DATABASE_URL=postgresql://postgres.[project-ref]:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=your-db-password

# OpenAI (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Server
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
ENVIRONMENT=development

# FRONTEND ENVIRONMENT VARIABLES

# Must be set at build time (Dockerfile ARG or Railway env var)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
